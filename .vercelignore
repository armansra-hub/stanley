# Vercel deployment filter. Keep this as a denylist: Git-sourced deployments
# also honor .vercelignore, so an ignore-all allowlist can omit the application
# itself. This mirrors the repository's ordinary secret/build exclusions while
# deliberately leaving committed public/art assets available to the build.
node_modules
.pnp
.pnp.*
.next
out
build
.env
.env.local
.env*.local
.env*
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
supabase/.branches
supabase/.temp
tsconfig.tsbuildinfo
.git
.foundation-run
