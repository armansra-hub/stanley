# ── Jarvis env — copy to .env.local and fill in. NEVER commit .env.local. ──

# Anthropic (classification/scoring summaries + chatbot)
ANTHROPIC_API_KEY=

# Apify (all paid scrapers). Actor IDs live in app_config.actors, not here.
APIFY_TOKEN=
# Some Crunchbase actors need their own key; leave blank if yours doesn't.
CRUNCHBASE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-side ONLY — never expose to the client

# Dedicated server-only credential for every /api/agent/* bridge request.
# Keep it independent from CRON_SECRET and send it only as Bearer/x-agent-token.
AGENT_TOKEN=
# Optional separately rotated equivalent retained for the Codex bridge.
CODEX_AGENT_TOKEN=

# Shared secret protecting /api/cron/* and /api/webhooks/* routes
CRON_SECRET=
# Optional separately rotated secret for public-growth cron routes. Send only in
# x-cron-secret/Authorization headers; never put either cron secret in a URL.
TAM_GROWTH_SWEEP_SECRET=

# Auth gate — leave BLANK for local (no login). On Vercel set BOTH to enable a
# single-user password login: APP_PASSWORD = what you type; APP_SESSION_TOKEN =
# any long random string (the session cookie value).
APP_PASSWORD=
APP_SESSION_TOKEN=

# Production only. In Vercel Production, set this to github-main-only-v1. Leave
# it blank locally and for Preview. This requests exact GitHub/main build
# attestation even if Vercel's optional system environment-variable exposure is
# disabled. Platform deployment permissions and live source readback remain the
# authoritative release gate.
STANLEY_PRODUCTION_SOURCE_POLICY=

# Optional CSV-upload enrichment helper (not used for discovery)
APOLLO_API_KEY=

# Optional: free Socrata app token raises FMCSA census rate limits
# (https://data.transportation.gov/profile/edit/developer_settings)
SOCRATA_APP_TOKEN=

# SEC EDGAR fair-access: a real email for the User-Agent (low-value source).
EDGAR_USER_AGENT_EMAIL=

# Base URL of your deployment (used by cron→async-actor webhooks). On Vercel,
# VERCEL_URL is used automatically if this is unset.
APP_BASE_URL=

# Display timezone for the dashboard clock (default America/Los_Angeles).
APP_TIMEZONE=
